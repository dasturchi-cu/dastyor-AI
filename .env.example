# ── BOT (required) ───────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=DastyorAiBot
ADMIN_USER_ID=123456789
PREMIUM_ADMIN_GROUP_ID=-1001234567890
SUPPORT_GROUP_ID=-1001234567890

# ── WEB / API (production) ───────────────────────────
SITE_BASE_URL=https://your-app.up.railway.app
WEBAPP_BASE=https://your-app.up.railway.app/webapp
WEBHOOK_URL=https://your-app.up.railway.app/webhook
WEBHOOK_SECRET=
INIT_DATA_MAX_AGE_SECONDS=86400
PORT=8000
WEBAPP_VERSION=20260622i
# Set on Railway/Render/VPS: PRODUCTION=1
PRODUCTION=
# Comma-separated extra CORS origins (optional)
CORS_EXTRA_ORIGINS=

# ── LOCAL DEV ONLY ─────────────────────────────────────
# Polling mode: SKIP_WEBHOOK=1 + python main.py
SKIP_WEBHOOK=
# Dev/smoke tests without Telegram initData: ALLOW_INSECURE_AUTH=1
ALLOW_INSECURE_AUTH=0

# ── PERSISTENT STORAGE ─────────────────────────────────
# Railway volume: mount at /data and set DATA_DIR=/data
DATA_DIR=
# RAILWAY_VOLUME_MOUNT_PATH=/data
DB_PATH=
# Optional template revision bumps (cache bust)
OBY_PREVIEW_TEMPLATE_REVISION=20260622-template-v2
CV_PREVIEW_TEMPLATE_REVISION=20250403-cv-ico

# ── PAYMENTS ───────────────────────────────────────────
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=
SINGLE_DOC_PRICE_UZS=7999
AUTO_APPROVE_PAYMENTS=1

# ── ADMIN JOBS ─────────────────────────────────────────
ADMIN_REPORT_HOUR=21
ADMIN_REPORT_TIMEZONE=Asia/Tashkent
PENDING_PAYMENT_REMINDER_HOURS=12
ADMIN_DASHBOARD_REFRESH_SEC=7
ONLINE_USER_MINUTES=5
INACTIVE_USER_DAYS=7

# ── AI (Gemini) ────────────────────────────────────────
GOOGLE_API_KEY=
AI_MAX_RETRIES=3
GEMINI_TIMEOUT=90

# ── PERFORMANCE ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
PERF_SLOW_REQUEST_MS=800

# ── REDIS (optional) ───────────────────────────────────
USE_REDIS=0
REDIS_URL=redis://redis:6379/0
