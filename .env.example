# Telegram Bot Configuration
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Database (optional for future)
# DATABASE_URL=postgresql://user:password@localhost:5432/lashbot

# Supabase — bot va /api uchun SERVERDA service_role majburiy deyarli (RLS yozish uchun)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Settings → API → service_role — brauzerga qo‘ymang!)
# SUPABASE_ANON_KEY=eyJ...           (ixtiyoriy, faqat fallback; RLS bilan yozmay qolishi mumkin)
# SUPABASE_URL to‘liq: https://xxxxxxxx.supabase.co (bo‘sh joy / noto‘g‘ri host — DNS xato)

# PDF: WeasyPrint tez; Playwright og‘ir
# CV PDF: Chromium birinchi — veb CV preview (iframe) bilan dizayn 1:1 ga yaqin (default 1).
# Render/Railway: build yoki startda `playwright install chromium` bo‘lishi kerak; bo‘lmasa WeasyPrint fallback.
# CV_PDF_PLAYWRIGHT_FIRST=1         (production tavsiyasi; 0 = avval WeasyPrint, tezroq lekin layout farqi)
# DISABLE_PLAYWRIGHT_PDF=1           (Obyektivka va boshqa HTML→PDF: Playwright o‘chiriladi)
# DISABLE_PLAYWRIGHT_CV_PDF=1      (faqat CV PDF ni WeasyPrint ga majbur qiladi — preview bilan farq)
# PLAYWRIGHT_AUTO_INSTALL=1         (so‘rov vaqtida chromium o‘rnatish — SEKIN, tavsiya etilmaydi)
# PDF_IMAGE_MAX_SIDE=1600           (rasm→PDF tezligi)

# Admin Settings
ADMIN_USER_ID=12345678

# API Keys (for future AI integrations)
# OPENAI_API_KEY=sk-...
# GOOGLE_CLOUD_KEY=...

# Webhook (full URL, including /webhook path)
# WEBHOOK_URL=https://yourdomain.com/webhook
# PORT=8080

# /start intro rasm: standart — ImgBB to‘g‘ri havola (i.ibb.co/....jpg). Sahifa ibb.co/... emas!
# Boshqa rasm: START_INTRO_PHOTO_URL=https://i.ibb.co/.../file.jpg
# URLni o‘chirish (faqat mahalliy fayl): START_INTRO_PHOTO_URL=
# Mahalliy zaxira: webapp/assets/hero-dastyor.png

# WebApp: bot tugmalari va ovozli obyektivka havolasi shu URL bilan ochiladi (API host bilan bir xil bo‘lishi kerak)
# WEBAPP_BASE=https://your-host/webapp
# WEBAPP_VERSION=20260322
# Supabase: ovoz → forma avto-to‘ldirish uchun migrate_safe_for_existing_db.sql (pending_oby_json ustunlari)
# Supabase foydalanuvchi sinxroni: har xabarda emas, N soniyada bir marta (tezlik). 0 = har safar.
# USER_SUPABASE_SYNC_SECONDS=35
# Supabase yoqilgan bo'lsa limitlar faqat DB da (bot+API alohida bo'lsa shart). DB ishlamasa:
# PLAN_QUOTA_LOCAL_FALLBACK_WITH_DB=1   (faqat bitta jarayon/server — test)

# === Infra (Docker Compose / Railway Redis) ===
# /api/me keshi va Celery uchun Redis majburiy (Railway: Redis plugin URL ni qo‘ying).
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# MAX_UPLOAD_BYTES=15728640
# JOB_TTL_SECONDS=3600
#
# === Performance (oxirgi yangilanish — ixtiyoriy) ===
# WebApp /api/me Redis keshi (soniya). 0 = kesh o‘chiq (debug).
# API_ME_CACHE_TTL_SECONDS=15
# Telegram Bot API HTTP pool (default kodda 20).
# PTB_POOL_SIZE=20
# Sekin so‘rovlar logi (ms). Shundan oshsa WARNING.
# PERF_SLOW_REQUEST_MS=800
# Barcha so‘rovlar vaqtini logga (faqat vaqtincha): 1 yoki true
# PERF_LOG_ALL=0
#
# === PaddleOCR (worker + sync /ocr) ===
# PADDLE_OCR_LANG=en
# PADDLE_OCR_MAX_SIDE=1800
# PADDLE_OCR_DET_LIMIT_SIDE_LEN=1800
# PADDLE_OCR_USE_GPU=0
# OCR_WORKERS=4
#
# === OCR 1:1 Table mode (ledger/forms) ===
# PaddleOCR bbox'laridan strict <table> grid yasab beradi (Gemini'dan oldin).
# OCR_PADDLE_TABLE_GRID=1
# Timeout (seconds) for Paddle table grid before Gemini fallback
# OCR_PADDLE_TABLE_GRID_TIMEOUT_SECONDS=5
#
# Gemini OCR flags (defaults: enhance/retry ON; binarize OFF)
# OCR_ENHANCE_IMAGE=1
# OCR_GEMINI_RETRY=1
# OCR_BINARIZE=0
#
# WebApp spellcheck API max body size (server-side; ai_service chunks long text)
# SPELLCHECK_MAX_CHARS=50000

# =============================================================================
# .env ga bitta joydan nusxa (Redis + tezlik).
# Eslatma: REDIS_URL allaqachon .env da bo‘lsa, ikki marta yozmang — birini o‘chiring.
# Railway: quyidagi redis URL ni o‘z Redis plugin qiymatingiz bilan almashtiring.
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MAX_UPLOAD_BYTES=15728640
JOB_TTL_SECONDS=3600
API_ME_CACHE_TTL_SECONDS=15
PTB_POOL_SIZE=20
PERF_SLOW_REQUEST_MS=800
PERF_LOG_ALL=0

# === Observability / Realtime debug (system_logs) ===
# SYSTEM_LOG_ENABLED=1
# SYSTEM_LOG_STACKTRACE=1
# ACTION_LOG_DEDUP_TTL_SECONDS=8
# ACTION_LOG_USE_REDIS=1

# === Sentry (Error Monitoring + Tracing) ===
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/123
# SENTRY_ENVIRONMENT=prod
# SENTRY_RELEASE=20260322
# SENTRY_TRACES_SAMPLE_RATE=0.15
# SENTRY_PROFILES_SAMPLE_RATE=0.0
