# Telegram Bot Configuration
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Database (optional for future)
# DATABASE_URL=postgresql://user:password@localhost:5432/lashbot

# Supabase — bot va /api uchun SERVERDA service_role majburiy deyarli (RLS yozish uchun)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Settings → API → service_role — brauzerga qo‘ymang!)
# SUPABASE_ANON_KEY=eyJ...           (ixtiyoriy, faqat fallback; RLS bilan yozmay qolishi mumkin)
# SUPABASE_URL to‘liq: https://xxxxxxxx.supabase.co (bo‘sh joy / noto‘g‘ri host — DNS xato)

# PDF: WeasyPrint tez; Playwright og‘ir
# CV PDF: Chromium birinchi — veb CV preview (iframe) bilan dizayn 1:1 ga yaqin (default 1).
# Render/Railway: build yoki startda `playwright install chromium` bo‘lishi kerak; bo‘lmasa WeasyPrint fallback.
# CV_PDF_PLAYWRIGHT_FIRST=1         (production tavsiyasi; 0 = avval WeasyPrint, tezroq lekin layout farqi)
# DISABLE_PLAYWRIGHT_PDF=1           (Obyektivka va boshqa HTML→PDF: Playwright o‘chiriladi)
# DISABLE_PLAYWRIGHT_CV_PDF=1      (faqat CV PDF ni WeasyPrint ga majbur qiladi — preview bilan farq)
# PLAYWRIGHT_AUTO_INSTALL=1         (so‘rov vaqtida chromium o‘rnatish — SEKIN, tavsiya etilmaydi)
# PDF_IMAGE_MAX_SIDE=1600           (rasm→PDF tezligi)

# Admin Settings
ADMIN_USER_ID=12345678

# API Keys (for future AI integrations)
# OPENAI_API_KEY=sk-...
# GOOGLE_CLOUD_KEY=...

# Webhook (full URL, including /webhook path)
# WEBHOOK_URL=https://yourdomain.com/webhook
# PORT=8080

# WebApp: bot tugmalari va ovozli obyektivka havolasi shu URL bilan ochiladi (API host bilan bir xil bo‘lishi kerak)
# WEBAPP_BASE=https://your-host/webapp
# WEBAPP_VERSION=20260322
# Supabase: ovoz → forma avto-to‘ldirish uchun migrate_safe_for_existing_db.sql (pending_oby_json ustunlari)
# Supabase foydalanuvchi sinxroni: har xabarda emas, N soniyada bir marta (tezlik). 0 = har safar.
# USER_SUPABASE_SYNC_SECONDS=35

# === Infra (Docker Compose) ===
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# MAX_UPLOAD_BYTES=15728640
# JOB_TTL_SECONDS=3600
#
# === PaddleOCR (worker + sync /ocr) ===
# PADDLE_OCR_LANG=en
# PADDLE_OCR_MAX_SIDE=1800
# PADDLE_OCR_DET_LIMIT_SIDE_LEN=1800
# PADDLE_OCR_USE_GPU=0
# OCR_WORKERS=4
#
# WebApp spellcheck API max body size (server-side; ai_service chunks long text)
# SPELLCHECK_MAX_CHARS=50000
