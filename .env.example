# ── BOT ──────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=DastyorAiBot
SUPPORT_ADMIN_USERNAME=DastyorAiAdmin
ADMIN_USER_ID=123456789
PREMIUM_ADMIN_GROUP_ID=-1001234567890
SUPPORT_GROUP_ID=-1001234567890

# ── WEB / API ────────────────────────────────────────
SITE_BASE_URL=https://dastyor-ai-production.up.railway.app
WEBAPP_BASE=https://dastyor-ai-production.up.railway.app/webapp
WEBHOOK_URL=https://dastyor-ai-production.up.railway.app/webhook
# Local polling only: SKIP_WEBHOOK=1 + python main.py
SKIP_WEBHOOK=
# Production: bo'sh yoki 0 (dev/smoke: 1)
ALLOW_INSECURE_AUTH=0
WEBHOOK_SECRET=
INIT_DATA_MAX_AGE_SECONDS=86400
PORT=8000
WEBAPP_VERSION=20260625g
# Preview cache (faqat shablon/mapper o'zgarganda) — docs/CACHE_REVISIONS.md
OBY_PREVIEW_TEMPLATE_REVISION=20260625-preview-works-fix

# Obyektivka vertikal masofalar (mm) — preview/demo/DOCX
OBY_HDR_TITLE_NAME_GAP_MM=1.5
OBY_HDR_BLOCK_MIN_HEIGHT_MM=28
OBY_HDR_NAME_BOTTOM_MM=0.5
OBY_FIELD_ROW_GAP_MM=1.8
OBY_CURRENT_JOB_BOTTOM_MM=2
OBY_SECTION_WORK_MARGIN_TOP_MM=1.2
OBY_SECTION_WORK_MARGIN_BOTTOM_MM=1
OBY_WORK_ITEM_GAP_MM=0.8
OBY_REL_TITLE_GAP_MM=3
# Master DOCX zaxira (twips)
OBY_DOCX_AFTER_FISH_TWIPS=200
OBY_DOCX_GRID_BEFORE_TWIPS=280
OBY_DOCX_MEHNAT_BEFORE_TWIPS=180
CV_PREVIEW_TEMPLATE_REVISION=20250403-cv-ico

# ── TO'LOV ───────────────────────────────────────────
PAYMENT_CARD_NUMBER=9860 1201 7225 8424
PAYMENT_CARD_OWNER=DILNOZA MOMINOVA
SINGLE_DOC_PRICE_UZS=7999
# Skrinshot kelgach avtomatik tasdiqlash (1=yoqilgan). Foydalanuvchi admin tekshirayotgandek ko'radi.
AUTO_APPROVE_PAYMENTS=1
# Avto-tasdiqdan oldin kutish (soniya) — firibgarlarni ushlash uchun
AUTO_APPROVE_DELAY_MIN_SEC=25
AUTO_APPROVE_DELAY_MAX_SEC=70

# ── ADMIN JOBS ───────────────────────────────────────
ADMIN_REPORT_HOUR=21
ADMIN_REPORT_TIMEZONE=Asia/Tashkent
# Eski PENDING test to'lovlari uchun eslatma (1=yoqilgan)
ENABLE_PENDING_PAYMENT_REMINDERS=1
# Qo'shimcha test telegram_id lar (vergul bilan)
PAYMENT_TEST_TELEGRAM_IDS=88001122,88003344,88005566,88007788,990001234,999888777,123456789
ADMIN_DASHBOARD_REFRESH_SEC=7
ONLINE_USER_MINUTES=5
INACTIVE_USER_DAYS=7

# ── AI (multi-provider failover) ─────────────────────
AI_PROVIDER=gemini
AI_FALLBACK_ORDER=openai,openrouter,groq,cloudflare
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1500
AI_PROVIDER_COOLDOWN_MS=900000
BOT_AI_COOLDOWN_MS=0
# Kunlik so'rov limiti (quota % hisobi) — provider bo'yicha
AI_QUOTA_DAILY_GEMINI=1500
AI_QUOTA_DAILY_OPENAI=10000
AI_QUOTA_DAILY_OPENROUTER=5000
AI_QUOTA_DAILY_GROQ=14400
AI_QUOTA_DAILY_CLOUDFLARE=10000

# Keys: comma list OR singular + _2, _3, …
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash-lite,gemini-2.0-flash,gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192

OPENAI_API_KEYS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACKS=gpt-4o,gpt-4.1-mini,gpt-4.1-nano

OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_MODEL_FALLBACKS=openai/gpt-4o-mini,openai/gpt-4o
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_X_TITLE=Sayqal AI

GROQ_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_FALLBACKS=llama-3.1-70b-versatile,gemma2-9b-it

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_MODEL_FALLBACKS=@cf/qwen/qwen1.5-14b-chat-awq

# Legacy single key (Gemini fallback if GEMINI_API_KEY unset)
GOOGLE_API_KEY=
GEMINI_TIMEOUT=90

# ── PERFORMANCE / SECURITY ───────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_USER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=500
AI_REQUESTS_PER_USER_DAY=50
MAX_UPLOAD_IMAGE_BYTES=6291456
MAX_UPLOAD_AUDIO_BYTES=10485760
ENFORCE_ORIGIN_CHECK=1
# Cloudflare Turnstile (https://dash.cloudflare.com) — bo'sh = o'chirilgan
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PERF_SLOW_REQUEST_MS=800

# ── REDIS (Railway Redis plugin qo'shsangiz: USE_REDIS=1) ─
USE_REDIS=0
REDIS_URL=redis://localhost:6379/0

# Optional admin debug API header
ADMIN_DEBUG_SECRET=

# ── PERSISTENT STORAGE ─────────────────────────────────
# Lokal: bo'sh qoldiring — default DATA_DIR/app.db (odatda project/data/app.db)
# Docker/Railway: DATA_DIR=/data (volume); DB_PATH ixtiyoriy, lekin /data ichida bo'lishi kerak
# DATA_DIR=/data
# DB_PATH=/data/app.db
# Test ma'lumotlarini har restartda tozalash (production: 0)
# PURGE_TEST_DATA_ON_STARTUP=0
# Demo PDF botga yuborish API (0=endpoint yashirin 404; production Docker: 1)
ENABLE_DEMO_PDF_API=1

# To'langan DOCX: HTML shablon → LibreOffice DOCX (preview bilan bir xil; 0=master zaxira)
OBY_DOCX_HTML_FIRST=1
